{
  "name": "zappy",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "prebuild": "npm run db:generate:portable",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts tests/*.test.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:dev": "prisma migrate dev",
    "db:seed": "tsx scripts/seed.ts",
    "setup:local": "bash scripts/setup-local.sh",
    "admin:provision": "tsx scripts/provision.ts",
    "test:e2e": "playwright test",
    "db:generate:portable": "tsx scripts/prisma-portable.ts generate",
    "db:migrate:portable": "tsx scripts/prisma-portable.ts migrate",
    "deploy:check": "node deploy/runtime-config.mjs",
    "release:check": "node deploy/check-release.mjs",
    "test:container": "tsx scripts/test-container.mjs"
  },
  "dependencies": {
    "@fontsource/rethink-sans": "^5.3.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@radix-ui/react-slot": "^1.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.60.0",
    "next": "^16.4.2",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@prisma/client-generator-js": "7.10.1",
    "@prisma/driver-adapter-utils": "7.10.1",
    "@prisma/internals": "7.10.1",
    "@prisma/schema-engine-wasm": "8.1.0-1.d1b3f377ca835d73fd50954a5e22128b9ebdd6b8",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dotenv": "^18.0.8",
    "prisma": "7.10.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
