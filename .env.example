# Local development only. setup:local creates .env with a random DB password.
DATABASE_URL=postgresql://zappy:CHANGE_ME@127.0.0.1:54329/zappy?schema=public
APP_ORIGIN=http://localhost:3000
# Set true when serving through HTTPS (mandatory in production).
COOKIE_SECURE=false
# Optional exact additional browser origins for separate frontend deployments (comma-separated).
# APP_ORIGINS=https://mesa.zappy.com.br,https://restaurante.zappy.com.br,https://cozinha.zappy.com.br,https://admin.zappy.com.br
# Set only for separate apps; root Netlify gateway serves the API directly.
# API_ORIGIN=https://api.zappy.com.br
# One-time CLI grant to an EXISTING account, never a browser setting:
# PLATFORM_ADMIN_EMAIL=admin@your-company.example
