# TEMPLATE ONLY. Use the host's secret manager; do not commit a filled copy.
# Staging uses separate hostnames, database and credentials from production.
NODE_ENV=production
DEPLOYMENT_ENV=staging
APP_ORIGIN=https://staging-restaurante.zappy.com.br
RESTAURANT_ORIGIN=https://staging-restaurante.zappy.com.br
COOKIE_SECURE=true
PAYMENTS_LIVE_ENABLED=false
# Set DATABASE_URL securely to the application role, with sslmode=verify-full.
# Optional private CA: mount it and use the provider's sslrootcert configuration.
# No database password belongs in this template or a NEXT_PUBLIC_* variable.
# The following domains are RESERVED, not working or published applications.
TABLET_ORIGIN=https://staging-mesa.zappy.com.br
KITCHEN_ORIGIN=https://staging-cozinha.zappy.com.br
PLATFORM_ORIGIN=https://staging-admin.zappy.com.br
API_ORIGIN=https://staging-api.zappy.com.br
